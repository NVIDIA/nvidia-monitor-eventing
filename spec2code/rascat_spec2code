class ErrorCatalog:
    def __init__(self, errorlist, devicelist):
        # csv.DictReader is a lazy dict, need to reload its content from
        # file after each iteration. So only cache errorlist here for reloading.
        self._errorlist = errorlist
        self._csvfields = self.get_columns()
        self._devicelist = devicelist

    def get_columns(self):
        with open(self._errorlist, 'r', encoding='utf-8') as csvfile:
            reader = csv.DictReader(csvfile)
            return reader.fieldnames

    def get_platforms(self):
        output = []
        with open(self._errorlist, 'r', encoding='utf-8') as csvfile:
            reader = csv.DictReader(csvfile)

            for field in reader.fieldnames:
                if not field.startswith(platform_column_prefix):
                    continue

                output.append(field[len(platform_column_prefix):])
        return output

    def json_acc_to_fc_expr(self, accessor):
        output = ""
        for key in accessor:
            if key == "check":  # TODO: this is WAR, need a common way
                continue
            output = output + "[ {0} | {1} ]; ".format(key, accessor[key])
        output = output[:-2]  # remove the tailing ';'
        return output

    def json_acc_list_to_fc_expr(self, accessors):
        output = ""
        for acc in accessors:
            output = output + self.json_acc_to_fc_expr(acc) + " : "
        output = output[:-3]  # remove the tailing " : "
        return output

    def fc_get_hw_signal(self, accessor):
        if accessor["type"] != "DBUS":
            return ""
        if accessor["interface"] != "xyz.openbmc_project.GpioStatus":
            return ""
        return accessor["property"]

    def json_arr_to_fc(self, json):
        return ';'.join(json)

    def fc_expr_to_json_acc(self, acc, chk=""):
        output = dict()
        if len(str(acc).strip()) == 0:
            return {}

        for wd in str(acc).strip().split(';'):
            kv = wd.strip().strip("][").split(" | ")
            output[kv[0].strip()] = kv[1].strip()
        if len(str(chk)) != 0:
            kv = str(chk).strip().strip("][").split(" | ")
            output['check'] = dict()
            output['check'][kv[0].strip()] = kv[1].strip()
        return output

    def fc_expr_to_json_acc_list(self, text):
        output = list()
        if len(str(text).strip()) == 0:
            return []

        for acc in str(text).strip().split(':'):
            output.append(self.fc_expr_to_json_acc(acc))

        return output

    def fc_expr_to_json_list(self, text):
        if len(str(text).strip()) == 0:
            return []
        output = list()
        for wd in str(text).strip().strip('][').split(","):
            output.append(wd.strip().strip("'"))
        return output

    def json_dev_name(self, device_type):
        return device_type.split('/')[0]

    def dot_query_json(self, json, dot_notation):
        if type(json) is str:
            return json
        keys = dot_notation.split('.')
        if len(keys) == 1:
            return json[keys[0]]
        else:
            return self.dot_query_json(json[keys[0]], '.'.join(keys[1:]))

    def to_ras_catalog(self, evt_inf_json):
        with open(evt_inf_json, "r") as f:
            evt_inf = json.load(f)
            print(','.join(self._csvfields))

            for dev_grp in evt_inf:
                for evt in evt_inf[dev_grp]:
                    row = ""
                    for col in self._csvfields:
                        try:
                            val = spec2code_dict[col]
                        except:
                            val = ""

                        cell = ""
                        try:
                            if len(val) == 0:
                                cell = ""
                            elif val[0] == '$':  # built-in function
                                func_name = re.split(r'\$|\(|\)|,', val)[1]
                                params = re.split(r'\$|\(|\)|,', val)[2:]

                                if func_name == "json_acc_to_fc_expr":
                                    cell = self.json_acc_to_fc_expr(
                                        self.dot_query_json(evt, params[0]))
                                elif func_name == "json_acc_list_to_fc_expr":
                                    cell = self.json_acc_list_to_fc_expr(
                                        self.dot_query_json(evt, params[0]))
                                elif func_name == "fc_get_hw_signal":
                                    cell = self.fc_get_hw_signal(
                                        self.dot_query_json(evt, params[0]))
                                elif func_name == "json_arr_to_fc":
                                    cell = self.json_arr_to_fc(
                                        self.dot_query_json(evt, params[0]))
                                elif func_name == "json_dev_name":
                                    cell = self.json_dev_name(
                                        self.dot_query_json(evt, params[0]))
                                elif func_name == "direct_value":
                                    cell = str(params[0]).title()
                                else:
                                    cell = "[E] Not support, " + func_name + "!"
                            else:  # direct content copy
                                cell = str(self.dot_query_json(evt, val))
                        except:
                            cell = ""

                        if cell.find(','):
                            cell = '"' + cell + '"'
                        row = row + cell + ','
                    print(row)

    def get_device_list(self, platform):
        output = dict()
        with open(self._devicelist, 'r', encoding='utf-8') as csvfile:
            reader = csv.DictReader(csvfile)

            id = 0
            for row in reader:
                id = id + 1
                if id == 1:
                    continue

                if not row['Platform'] == platform:
                    continue

                output[row['DevicePattern']] = {key: value for key, value in row.items() if key != 'DevicePattern' and key != 'Platform'}

        print(f"get_device_list: output = {output}", file=sys.stderr)
        return output

    def get_device_list_sim(self, platform):
        output = dict()
        with open(self._devicelist, 'r', encoding='utf-8') as csvfile:
            reader = csv.DictReader(csvfile)

            id = 0
            for row in reader:
                id = id + 1
                if id == 1:
                    continue

                if not row['Platform'] == platform:
                    continue

                prefix = row['RF Chassis URI Device Prefix']
                print(f"device_prefix = {prefix}", file=sys.stderr)

                output[row['Device In RF Content']] = row['RF URI Prefix'] + \
                    (prefix + "_" if prefix != "" else "")

        print(f"get_device_list_sim: output = {output}", file=sys.stderr)
        return output

    def to_event_info_json(self, platform):
        with open(self._errorlist, "r", encoding='utf-8') as f:
            fc = csv.DictReader(f)

            ei_json = copy.deepcopy(event_info_json)

            platform_column = platform_column_prefix + platform

            if platform_column not in self._csvfields:
                print("[E] invalid platform: ", platform)
                return 1

            device_pattern = self.get_device_list(platform)
            device_rf_pattern = self.get_device_list_sim(platform)

            def pattern2device(text):
                import re

                pattern = r"\{(.*?)\}"
                matches = re.findall(pattern, text)
                for i, match in enumerate(matches):
                    key = "{" + match + "}"

                    print(f"pattern2device: key = {key}", file=sys.stderr)
                    if key not in device_pattern:
                        print(f"pattern2device: key = {key} not in device_pattern", file=sys.stderr)
                        continue
                    text = text.replace(key,
                        device_pattern[key]['Device In RF Content'])
                    print(f"pattern2device: text = {text}", file=sys.stderr)
                return text

            def adjust_mapping_device_pattern(row):
                for field in row.keys():
                    if field == "Device Type":
                        continue
                    if row[field] == row['Device Type']:
                        continue
                    if "SXM" not in row[field]: # Only SXM device need to be adjusted
                        continue
                    if row['Device Type'] not in device_pattern:
                        continue
                    mapping_device_range = device_pattern[row['Device Type']]['Mapping Device Range']
                    if mapping_device_range is None or mapping_device_range == "":
                        continue
                    mapping_device = row[field]
                    if mapping_device not in device_pattern:
                        continue

                    row[field] = (
                        device_pattern[mapping_device]['Device'] +
                        "_" + mapping_device_range
                    )
                return row

            def make_ooc_uri(device):
                if device in device_rf_pattern:
                    return device_rf_pattern[device] + device
                else:
                    return "/redfish/v1/Chassis/HGX_" + device

            def accessor_pattern_converter(accessor):
                for key in accessor.keys():
                    print(f"accessor_pattern_converter: key = {key}", file=sys.stderr)
                    if key == "check":
                        continue
                    value = pattern2device(accessor[key])
                    print(f"accessor_pattern_converter: value[{key}] = {value}", file=sys.stderr)
                    if value == "":
                        continue
                    accessor[key] = value
                    print(f"accessor_pattern_converter: accessor[{key}] = {accessor[key]}", file=sys.stderr)
                return accessor

            id = 0
            for row in fc:
                id = id + 1
                if id == 1:
                    continue

                if row[platform_column].lower() != "yes":
                    continue

                if row["RF Log Producer"].lower() != "eventingservice":
                    continue

                if row["To HMC Code?"].lower() != "yes":
                    continue

                row = adjust_mapping_device_pattern(row)
                row = {key: pattern2device(value) for key, value in row.items()}

                ee = copy.deepcopy(event_entry_json)

                ee["event"] = row["Impacted Component"] + " " + row["Event Name"]
                ee["device_type"] = row["Device Type"]
                ee["error_id"] = row["Error ID"]
                ee["error_type"] = row["Error Type"]
                ee["managed"] = row["RF Managed Error"].strip().lower()
                ee["rollup_device"] = row["RF Rollup to Device"]
                ee["category"] = self.fc_expr_to_json_list(row["Layer"])

                ee["event_trigger"] = self.fc_expr_to_json_acc(
                    row["Trigger data config"], row["Trigger check"])
                ee["event_trigger"] = accessor_pattern_converter(ee["event_trigger"])

                ee["accessor"] = self.fc_expr_to_json_acc(
                    row["Accessor data config"], row["Accessor check"])
                ee["accessor"] = accessor_pattern_converter(ee["accessor"])

                if len(str(row["Recovery data config"]).strip()) == 0:
                    ee.pop("recovery")
                else:
                    ee["recovery"] = self.fc_expr_to_json_acc(
                        row["Recovery data config"], row["Recovery check"])
                    ee["recovery"] = accessor_pattern_converter(ee["recovery"])
                ee["severity"] = row["RF Log Health"]
                ee["resolution"] = row["RF Log Resolution"]
                ee["debounce"]["type"] = row["Debounce type"]
                ee["debounce"]["duration"] = row["Debounce duration"]

                ee["trigger_count"] = (
                    int(row["Leaky bucket trigger count"], 10)
                    if len(row["Leaky bucket trigger count"]) > 0 else 0
                )

                ee["event_counter_reset"] = self.fc_expr_to_json_acc(
                    row["Leaky bucket reset type"])
                ee["redfish"]["message_id"] = row["RF Log Message ID"]
                ee["redfish"]["origin_of_condition"] = make_ooc_uri(
                    row["RF Log Origin Of Condition"])

                ee["redfish"]["message_args"]["patterns"] = self.fc_expr_to_json_list(
                    row["RF Log Message Args"])
                ee["redfish"]["message_args"]["parameters"] = self.fc_expr_to_json_acc_list(
                    row["MessageArgs Parameters"])

                ee["log_namespace"] = row["RF Log Namespace"]
                ee["telemetries"] = self.fc_expr_to_json_acc_list(
                    row["AdditionalData data config (possibly multiple)"])
                ee["action"] = ""
                ee["value_as_count"] = row["Data value is event count"].strip().lower() == "true"
                ee["description"] = row["Description"]

                # Add error type if present
                if 'Error Type' in row and row['Error Type']:
                    ee['error_type'] = row['Error Type']
                else:
                    ee['error_type'] = ""  # Default empty string if not specified

                ei_json["Device"].append(ee)

            ei_json["Device"].sort(key=lambda e: e.get("error_id"))
            print(json.dumps(ei_json, indent=2))
            return 0

    def to_obmc_platform_config(self, platform):
        with open(self._errorlist, "r", encoding='utf-8') as f:
            fc = csv.DictReader(f)

            ei_json = copy.deepcopy(event_info_json)
            dat_json = {}
            rf_msgreg_csv = []

            platform_column = platform_column_prefix + platform

            if platform_column not in self._csvfields:
                print("[E] invalid platform: ", platform)
                return 1

            output_dir = platform_column.replace(" ", "_").lower()
            os.makedirs(output_dir, exist_ok=True)


            device_pattern = self.get_device_list(platform)
            device_rf_pattern = self.get_device_list_sim(platform)

            def pattern2device(text):
                import re

                pattern = r"\{(.*?)\}"
                matches = re.findall(pattern, text)
                for i, match in enumerate(matches):
                    key = "{" + match + "}"

                    print(f"pattern2device: key = {key}", file=sys.stderr)
                    if key not in device_pattern:
                        print(f"pattern2device: key = {key} not in device_pattern", file=sys.stderr)
                        continue
                    text = text.replace(key,
                        device_pattern[key]['Device In RF Content'])
                    print(f"pattern2device: text = {text}", file=sys.stderr)
                return text

            def adjust_mapping_device_pattern(row):
                for field in row.keys():
                    if field == "Device Type":
                        continue
                    if row[field] == row['Device Type']:
                        continue
                    if "SXM" not in row[field]: # Only SXM device need to be adjusted
                        continue
                    if row['Device Type'] not in device_pattern:
                        continue
                    mapping_device_range = device_pattern[row['Device Type']]['Mapping Device Range']
                    if mapping_device_range is None or mapping_device_range == "":
                        continue
                    mapping_device = row[field]
                    if mapping_device not in device_pattern:
                        continue

                    row[field] = (
                        device_pattern[mapping_device]['Device'] +
                        "_" + mapping_device_range
                    )
                return row

            # Get device RF URI from device pattern
            def get_device_uri_without_range(device):
                if device in device_pattern:
                    rf_uri_prefix = device_pattern[device]['RF URI Prefix']
                    rf_device = device_pattern[device]['Device']
                    rf_chs_prefix = device_pattern[device]['RF Chassis URI Device Prefix']
                    rf_chs_prefix += "_" if rf_chs_prefix != "" else ""
                    return rf_uri_prefix + rf_chs_prefix + rf_device
                else:
                    print(f"get_device_uri_without_range: device = {device} not in device_pattern", file=sys.stderr)
                    return None

            # Make OOC URI per SRC "Error List".col[RF Log Origin Of Condition] directly
            # Input: device - device name listed in "Error List".col[RF Log Origin Of Condition]
            def make_ooc_uri(device):
                print(f"make_ooc_uri: RF OOC device = {device}", file=sys.stderr)
                if device in device_rf_pattern:
                    print(f"make_ooc_uri: device = {device} in device_rf_pattern", file=sys.stderr)
                    return device_rf_pattern[device] + device
                else:
                    print(f"make_ooc_uri: device = {device} not in device_rf_pattern", file=sys.stderr)
                    print(f"Make up OOC URI for {device} as /redfish/v1/Chassis/HGX_{device}", file=sys.stderr)
                    return "/redfish/v1/Chassis/HGX_" + device

            # Make OOC URI per SRC Devices.col[FRU Location]
            # Input: device - device that error occurred on, listed in "Error List".col[Device Type]
            def make_ooc_uri_v2(device):
                print(f"make_ooc_uri_v2: device = {device}", file=sys.stderr)
                device = device.split('/')[0]
                print(f"make_ooc_uri_v2: main device = {device}", file=sys.stderr)
                if device in device_pattern:
                    fru_loc = device_pattern[device].get('FRU Location', None)
                    if fru_loc == None:
                        print(f"make_ooc_uri_v2: fru_loc for {device} is None", file=sys.stderr)
                        return ""
                    range = device_pattern[device]['Mapping Device Range']
                    if range == None or range == "":
                        range = device_pattern[device]["Range"]
                    return get_device_uri_without_range(fru_loc) + "_" + range
                else:
                    print(f"make_ooc_uri_v2: device = {device} not in device_pattern", file=sys.stderr)
                    return None


            def accessor_pattern_converter(accessor):
                for key in accessor.keys():
                    print(f"accessor_pattern_converter: key = {key}", file=sys.stderr)
                    if key == "check":
                        continue
                    value = pattern2device(accessor[key])
                    print(f"accessor_pattern_converter: value[{key}] = {value}", file=sys.stderr)
                    if value == "":
                        continue
                    accessor[key] = value
                    print(f"accessor_pattern_converter: accessor[{key}] = {accessor[key]}", file=sys.stderr)
                return accessor

            id = 0
            for row in fc:
                id = id + 1
                if id == 1:
                    continue

                if row[platform_column].lower() != "yes":
                    continue

                if row["RF Log Producer"].lower() != "eventingservice":
                    continue

                if row["To HMC Code?"].lower() != "yes":
                    continue

                row_orig = row
                row = adjust_mapping_device_pattern(row)
                row = {key: pattern2device(value) for key, value in row.items()}

                ee = copy.deepcopy(event_entry_json) # Event Entry JSON
                de = {} # DAT Entry JSON
                mr = {} # RF Message Registry CSV Entry

                # event_info.json entry generation
                ee["event"] = row["Impacted Component"] + " " + row["Event Name"]
                ee["device_type"] = row["Device Type"]
                ee["error_id"] = row["Error ID"]
                ee["error_type"] = row["Error Type"]
                ee["managed"] = row["RF Managed Error"].strip().lower()
                ee["rollup_device"] = row["RF Rollup to Device"]
                ee["category"] = self.fc_expr_to_json_list(row["Layer"])

                ee["event_trigger"] = self.fc_expr_to_json_acc(
                    row["Trigger data config"], row["Trigger check"])
                ee["event_trigger"] = accessor_pattern_converter(ee["event_trigger"])

                ee["accessor"] = self.fc_expr_to_json_acc(
                    row["Accessor data config"], row["Accessor check"])
                ee["accessor"] = accessor_pattern_converter(ee["accessor"])

                if len(str(row["Recovery data config"]).strip()) == 0:
                    ee.pop("recovery")
                else:
                    ee["recovery"] = self.fc_expr_to_json_acc(
                        row["Recovery data config"], row["Recovery check"])
                    ee["recovery"] = accessor_pattern_converter(ee["recovery"])
                ee["severity"] = row["RF Log Health"]
                ee["resolution"] = row["RF Log Resolution"]
                ee["debounce"]["type"] = row["Debounce type"]
                ee["debounce"]["duration"] = row["Debounce duration"]

                ee["trigger_count"] = (
                    int(row["Leaky bucket trigger count"], 10)
                    if len(row["Leaky bucket trigger count"]) > 0 else 0
                )

                ee["event_counter_reset"] = self.fc_expr_to_json_acc(
                    row["Leaky bucket reset type"])
                ee["redfish"]["message_id"] = row["RF Log Message ID"]
                ooc = make_ooc_uri_v2(row_orig["Device Type"])
                if ooc == "":
                    ooc = make_ooc_uri(row["RF Log Origin Of Condition"])
                ee["redfish"]["origin_of_condition"] = ooc

                ee["redfish"]["message_args"]["patterns"] = self.fc_expr_to_json_list(
                    row["RF Log Message Args"])
                ee["redfish"]["message_args"]["parameters"] = self.fc_expr_to_json_acc_list(
                    row["MessageArgs Parameters"])

                ee["log_namespace"] = row["RF Log Namespace"]
                ee["telemetries"] = self.fc_expr_to_json_acc_list(
                    row["AdditionalData data config (possibly multiple)"])
                ee["action"] = ""
                ee["value_as_count"] = row["Data value is event count"].strip().lower() == "true"
                ee["description"] = row["Description"]

                # Add error type if present
                if 'Error Type' in row and row['Error Type']:
                    ee['error_type'] = row['Error Type']
                else:
                    ee['error_type'] = ""  # Default empty string if not specified

                ei_json["Device"].append(ee)

                # dat.json entry generation

                # RF Message Registry CSV Entry generation
                mr["Error ID"] = row["Error ID"]
                for key in ["RF Log Message ID", "RF Log Message Args", "RF Log Resolution"]:
                    print(f"mr[{key}] = {row[key]}", file=sys.stderr)
                    mr["Redfish MessageRegistry"] = key
                    mr["Current"] = row[key]
                    mr["New"] = ""

                    rf_msgreg_csv.append(dict(mr))

            ei_json["Device"].sort(key=lambda e: e.get("error_id"))

            # Write output files
            print(f"Writing output files \"event_info.json\" to {output_dir}", file=sys.stderr)
            with open(os.path.join(output_dir, "event_info.json"), "w", encoding='utf-8') as f:
                json.dump(ei_json, f, indent=2)
            print(f"Writing output files \"dat.json\" to {output_dir}", file=sys.stderr)
            with open(os.path.join(output_dir, "dat.json"), "w", encoding='utf-8') as f:
                json.dump(dat_json, f, indent=2)
            print(f"Writing output files \"rf_msgreg.csv\" to {output_dir}", file=sys.stderr)
            with open(os.path.join(output_dir, "rf_msgreg.csv"), "w", encoding='utf-8') as f:
                writer = csv.DictWriter(f, fieldnames=rf_msgreg_csv[0].keys())
                writer.writeheader()
                writer.writerows(rf_msgreg_csv)
            return 0

    def get_layer(self, alert_name: str) -> str:
        """Determine Layer value based on alert name"""
        alert_lower = alert_name.lower()
        if any(term in alert_lower for term in ['pwr', 'power', 'vdd', 'vcc']):
            return "power_rail"
        elif any(term in alert_lower for term in ['temp', 'therm', 'overt']):
            return "thermal_control"
        elif any(term in alert_lower for term in ['i2c', 'pcie', 'bus']):
            return "interface_status"
        elif any(term in alert_lower for term in ['prsnt', 'gpio']):
            return "pin_status"
        elif any(term in alert_lower for term in ['erot', 'irot']):
            return "erot-control"
        return ""

    def count_per_device(self, platform):
        with open(self._errorlist, "r", encoding='utf-8') as f:
            fc = csv.DictReader(f)

            ei_json = copy.deepcopy(event_info_json)

            platform_column = platform_column_prefix + platform

            total_count = 0
            device_count = dict()
            for row in fc:
                if row[platform_column].lower() != "yes":
                    continue

                if row["RF Log Producer"].lower() != "eventingservice":
                    continue

                total_count += 1 # count the total number of alerts

                # counting per device
                device_name = str(row["Impacted Component"])
                print(f"device_name = {device_name}", file=sys.stderr)
                # if device_name is not in device_count, add it with count 0
                if device_name not in device_count:
                    print(f"device_name = {device_name} not in device_count", file=sys.stderr)
                    device_count[device_name] = 0
                # increment the count for the device
                device_count[device_name] += 1
                print(f"device_count[{device_name}] = {device_count[device_name]}", file=sys.stderr)

            print(f"Total number of alerts: {total_count}", file=sys.stderr)
            #pprint(device_count, stream=sys.stderr)
            for device, count in device_count.items():
                print(f"{device}: {count}", file=sys.stderr)

            return total_count, device_count

def get_hardware_signal(int_for_hmc: str) -> str:
    """Convert Int for HMC value to hardware signal name"""
    if int_for_hmc == "T":
        return "THERM_OVERT"
    elif int_for_hmc == "PF":
        return "PS_RUN_PWR_FAULT"
    elif int_for_hmc.isdigit():
        return f"I2C{int_for_hmc}_ALERT"
    return int_for_hmc

def is_thermal_warning_alert(alert_name: str) -> bool:
    """Check if alert name indicates a thermal warning/alert"""
    alert_lower = alert_name.lower()
    return any(term in alert_lower for term in ['temp', 'therm'])

def get_device_name(alert_name: str) -> str:
    """Get device name from alert name following the policies:
    1. Take portion before first "_"
    2. If device_name is "I2C"+number, remove the number part
    """
    device_name = alert_name.split('_')[0]
    # Special handling for I2C+number case
    if device_name.startswith('I2C') and device_name[3:].isdigit():
        device_name = 'I2C'  # Remove the number part
    elif device_name in ["NVSwitch", "NVSW", "QM3"]:
        device_name = "NVSwitch"
    elif device_name in ["PEX", "PEXSW"]:
        device_name = "NVLinkManagementNIC"
    elif device_name in ["ConnectX", "CX8"]:
        device_name = "ConnectX"

    return device_name

def get_device_pattern(device_name: str) -> str:
    """Get device pattern from device_name"""
    if device_name == "":
        return ""
    elif device_name in ["GPU", "CPU", "NVSwitch", "HMC", "HSCC", "HSC"]:
        return "{" + device_name + "DeviceID}"
    else:
        return "{" + device_name + "ID}"

def get_rollup_device(device_name: str, is_managed: bool) -> str:
    """Get RF Rollup to Device value based on device name and managed status"""
    if not is_managed:
        return ""

    if device_name in ["GPU", "CPU", "NVSwitch", "NVLinkManagementNIC", "ConnectX"]:
        return device_name
    else:
        return "Baseboard"

def get_ooc_device(device_name: str) -> str:
    """Get OOC device name from device name"""
    if device_name in ["GPU", "CPU"]:
        return device_name
    else:
        return "Baseboard"

def convert_bit_range(bits: str) -> str:
    """Convert bit range from [n:m] format to [m-n] format"""
    if ':' not in bits:
        return bits
    start, end = bits.split(':')
    return f"[{end}-{start}]"

def fpga_alert_rascat(
    rascat_file: str,
    fpga_regtbl_file: str,
    sheet_name: str = "register table"
) -> int:
    """Convert FPGA register table alerts to RAS catalog entries"""
    # Initialize statistics counters
    stats = {
        'total_entries': 0,
        'interrupt_capable': 0,
        'fully_masked': 0,
        'partial_masked': 0,
        'not_masked': 0,
        'valid_interrupts': 0
    }

    try:
        # Convert Excel to CSVs and get the columns from RAS catalog
        csv_errorlist = convert_xlsx_to_csv(rascat_file, "Error List")
        csv_devicelist = convert_xlsx_to_csv(rascat_file, "Devices")

        ras_catalog = ErrorCatalog(csv_errorlist, csv_devicelist)
        srascat_columns = ras_catalog.get_columns()

        # Load FPGA register table
        print(
            f"Loading FPGA register table from {fpga_regtbl_file}, "
            f"sheet: {sheet_name}",
            file=sys.stderr
        )
        regtbl_df = load_fpga_register_table(fpga_regtbl_file, sheet_name)
        stats['total_entries'] = len(regtbl_df)

        # Filter for interrupt registers
        int_registers = regtbl_df[
            (regtbl_df['Int for HMC'].notna()) &
            (regtbl_df['Bits'].notna()) &
            (regtbl_df['Address Start'].notna())
        ]
        stats['interrupt_capable'] = len(int_registers)

        # Set up CSV writer for stdout
        csv_writer = csv.DictWriter(sys.stdout, fieldnames=srascat_columns)
        csv_writer.writeheader()

        # Process each interrupt register
        for _, int_reg in int_registers.iterrows():
            reg_name = int_reg['Reg Name']
            print(f"Processing register: {reg_name}", file=sys.stderr)

            # Check for corresponding mask register
            mask_reg_name = reg_name.replace('_INT', '_MASK')
            mask_reg = regtbl_df[regtbl_df['Reg Name'] == mask_reg_name]

            if not mask_reg.empty:
                mask_default = str(mask_reg.iloc[0]['Default'])
                if mask_default.strip():  # If mask default exists
                    if all(c == '1' for c in mask_default if c.isdigit()):
                        stats['fully_masked'] += 1
                        continue
                    elif any(c == '1' for c in mask_default if c.isdigit()):
                        stats['partial_masked'] += 1
                    else:
                        stats['not_masked'] += 1

            # Handle Address End - if empty, use Address Start
            addr_end = int_reg['Address End']
            if pd.isna(addr_end) or addr_end == "":
                int_reg['Address End'] = int_reg['Address Start']

            # Create alert name from register name
            # Remove array indices if present
            alert_name = reg_name.split('[')[0]

            # Get device_name following the policies
            device_name = get_device_name(alert_name)
            is_thermal = is_thermal_warning_alert(alert_name)

            # Create entry dictionary with all columns initialized to empty string
            entry = {col: "" for col in srascat_columns}

            # Get device range from register bits or name
            device_range = ""
            if '[' in reg_name:
                device_range = reg_name[reg_name.find('['):reg_name.find(']')+1]
                if ':' in device_range:
                    # Remove [] before converting
                    device_range = convert_bit_range(device_range[1:-1])
            elif int_reg['Bits']:
                bits = str(int_reg['Bits'])
                if ':' in bits:
                    device_range = convert_bit_range(bits)
                else:
                    device_range = "0"
            else:
                device_range = "0"

            # Get device type from device name
            device_type = get_rollup_device(device_name, not is_thermal)
            if device_type == "":
                device_type = "Baseboard"

            # Fill in the values we know based on the processing rules
            entry.update({
                'Error ID': f"{alert_name}-ERROR",
                'Error Name': f"{alert_name} Abnormal State Change",
                'Impacted Component': device_name,
                'Description': f"FPGA interrupt {alert_name} happens.",
                'To HMC Code?': "yes",
                'Hardware/GPIO Signal': get_hardware_signal(
                    str(int_reg['Int for HMC'])
                ),
                'Error Telemetry': "BASEBOARD-REDFISH-EVENT-LOG",
                'RF Managed Error': "no" if is_thermal else "yes",
                'RF Rollup to Device': get_device_pattern(
                    get_rollup_device(device_name, not is_thermal)
                ),
                'RF Log Producer': "EventingService",
                'RF Log URI': "/redfish/v1/Systems/{SystemID}/LogServices/EventLog",
                'RF Log Message ID': "ResourceEvent.1.0.ResourceErrorsDetected",
                'RF Log Message Args': (
                    f"['" + get_device_pattern(device_type) +
                    f" {alert_name}', 'Abnormal State Change']"
                ),
                'RF Log Health': "Warning" if is_thermal else "Critical",
                'RF Log Resolution': (
                    "AC cycle the system. If problem persists, collect all dumps "
                    "per troubleshooting guide, isolate the system and evaluate "
                    "for RMA."
                ),
                'Resolution ID': "COLLECT_LOGS",
                'Event Name': f"{alert_name} Abnormal State Change",
                'Device Type': get_device_pattern(device_type),
                'Error Type': "FPGA-ALERT",
                'Trigger data config': (
                    f"[ type | DBUS ]; [ object | /xyz/openbmc_project/"
                    f"GpioStatusHandler ]; [ interface | xyz.openbmc_project."
                    f"GpioStatus ]; [ property | {get_hardware_signal(str(int_reg['Int for HMC']))} ]"
                ),
                'Trigger check': "[ equal | false ]",
                'Accessor data config': (
                    f"[ type | CMDLINE ]; [ executable | fpga_regtbl ]; "
                    f"[ arguments | {alert_name} {device_range} ]"
                ),
                'Accessor check': "[ equal | 1 ]",
                'Leaky bucket trigger count': "0",
                'Data value is event count': "FALSE",
                'RF Log Namespace': get_device_pattern(device_type),
                'RF Log Origin Of Condition': get_device_pattern(
                    get_ooc_device(device_name)
                ),
                'Layer': ras_catalog.get_layer(alert_name)
            })

            # Write entry using CSV writer to properly handle commas
            csv_writer.writerow(entry)

            stats['valid_interrupts'] += 1

        # Print statistics to stderr
        print("\nProcessing Statistics:", file=sys.stderr)
        print(f"Total entries in FRTL: {stats['total_entries']}", file=sys.stderr)
        print(
            f"Interrupt-capable entries: {stats['interrupt_capable']}",
            file=sys.stderr
        )
        print(f"Mask register statistics:", file=sys.stderr)
        print(f"  Fully masked: {stats['fully_masked']}", file=sys.stderr)
        print(f"  Partially masked: {stats['partial_masked']}", file=sys.stderr)
        print(f"  Not masked: {stats['not_masked']}", file=sys.stderr)
        print(
            f"Valid interrupts processed: {stats['valid_interrupts']}",
            file=sys.stderr
        )

        return 0
    finally:
        # Clean up temporary CSV files
        os.remove(csv_errorlist)
        os.remove(csv_devicelist)

def convert_xlsx_to_csv(xlsx_file, sheet_name):
    import pandas as pd

    # Read the specified sheet from the Excel file
    df = pd.read_excel(xlsx_file, sheet_name=sheet_name)

    # Make the csv file path.
    csv_file = "/tmp/" + sheet_name.replace(" ", "_") + ".csv"

    # Convert the DataFrame to a CSV file
    df.to_csv(csv_file, index=False, encoding='utf-8')

    return csv_file

def load_fpga_register_table(fpga_regtbl_file: str, sheet_name: str) -> pd.DataFrame:
    """Load FPGA register table from Excel file"""
    try:
        df = pd.read_excel(fpga_regtbl_file, sheet_name=sheet_name)
        required_columns = [
            'Reg Name', 'Address Start', 'Address End',
            'Bits', 'Int for HMC', 'Default'
        ]
        if not all(col in df.columns for col in required_columns):
            raise ValueError(
                f"Missing required columns. Expected: {required_columns}"
            )
        return df
    except Exception as e:
        print(f"Error loading FPGA register table: {e}", file=sys.stderr)
        sys.exit(1)

help_example = """\
Examples,
  ./rascat_spec2code Server-RAS-Catalog.xlsx to_event_info_json \
Blackwell-HGX-8-GPU > event_info.json
  ./rascat_spec2code Server-RAS-Catalog.xlsx to_event_info_json \
