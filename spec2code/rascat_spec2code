  ./rascat_spec2code Server-RAS-Catalog.xlsx to_obmc_platform_config "GB200 NVL"\
"""

def main():
    parser = argparse.ArgumentParser(
        description=__doc__,
        formatter_class=argparse.RawTextHelpFormatter,
        epilog=help_example
    )

    parser.add_argument(
        "ras_catalog",
        metavar="ras_catalog",
        help="Server-RAS-Catalog.xlsx downloaded from \n"
             "'https://docs.google.com/spreadsheets/d/"
             "1X1eSW7A6ai5VwzTiytt5PouGiz7KvxmR4VFfsZ9bP_Q'."
    )

    conv_method_help_msg = [
        method for method in dir(ErrorCatalog) if method.startswith("to_")
    ]
    conv_method_help_msg.append("fpga_alert_rascat")  # Add the new method

    parser.add_argument(
        "conv_method",
        metavar="conv_method",
        help="Specify how to convert the spec to code. Options:\n  " +
             "\n  ".join(conv_method_help_msg) + "\n"
    )

    parser.add_argument(
        "arg3",
        nargs="?",
        help="Platform name for to_event_info_json or "
             "FPGA register table file for fpga_alert_rascat"
    )

    parser.add_argument(
        "--sheet",
        default="register table",
        help="Sheet name in FPGA register table Excel file "
             "(default: 'register table')"
    )

    args = parser.parse_args()

    supported_methods = [
        m for m in dir(ErrorCatalog) if callable(getattr(ErrorCatalog, m)) and not m.startswith("__")
    ]
    print("\n".join(supported_methods), file=sys.stderr)

    # Validate and assign arguments based on conv_method
    if args.conv_method == "to_event_info_json":
        args.platform = args.arg3
        args.fpga_regtbl_file = None
        if not args.platform:
            parser.error("Missing platform argument for to_event_info_json")
    elif args.conv_method == "to_obmc_platform_config":
        args.platform = args.arg3
        args.fpga_regtbl_file = None
        if not args.platform:
            parser.error("Missing platform argument for to_obmc_platform_config")
    elif args.conv_method == "fpga_alert_rascat":
        args.fpga_regtbl_file = args.arg3
        args.platform = None
        if not args.fpga_regtbl_file:
            parser.error("Missing FPGA register table file argument")
    elif args.conv_method in supported_methods:
        args.platform = args.arg3
        args.fpga_regtbl_file = None
        if not args.platform:
            parser.error("Missing platform argument for " + args.conv_method)

    ras_catalog = args.ras_catalog

    csv_errorlist = convert_xlsx_to_csv(ras_catalog, "Error List")
    csv_devicelist = convert_xlsx_to_csv(ras_catalog, "Devices")

    ras_catalog = ErrorCatalog(csv_errorlist, csv_devicelist)

    rc = 0

    if args.conv_method == "to_ras_catalog":
        rc = ras_catalog.to_ras_catalog(evt_inf_json)
    elif args.conv_method == "to_event_info_json":
        rc = ras_catalog.to_event_info_json(args.platform)
    elif args.conv_method == "to_obmc_platform_config":
        rc = ras_catalog.to_obmc_platform_config(args.platform)
    elif args.conv_method == "get_columns":
        rc = print(ras_catalog.get_columns())
    elif args.conv_method == "get_platforms":
        rc = print("\n".join(ras_catalog.get_platforms()))
    elif args.conv_method == "get_device_list":
        rc = pprint(ras_catalog.get_device_list(args.platform))
    elif args.conv_method == "fpga_alert_rascat":
        if not args.fpga_regtbl_file:
            print("Error: Missing FPGA register table file argument")
            return 1
        rc = fpga_alert_rascat(
            args.ras_catalog,
            args.fpga_regtbl_file,
            args.sheet
        )
        # Skip cleanup since fpga_alert_rascat handles it
        return rc
    elif args.conv_method in supported_methods:
        rc = getattr(ras_catalog, args.conv_method)(args.platform)
    else:
        print("Wrong args: ", args.conv_method)
        rc = 1

    # Clean up (only for non-fpga_alert_rascat commands)
    os.remove(csv_errorlist)
    os.remove(csv_devicelist)

    return rc

if __name__ == "__main__":
    main()
